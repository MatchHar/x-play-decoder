diff --git a/compileAndBuildVLCKit.sh b/compileAndBuildVLCKit.sh
--- a/compileAndBuildVLCKit.sh
+++ b/compileAndBuildVLCKit.sh
@@ -269,7 +269,9 @@ buildMobileKit() {
                 echo "*** Framework ARCH: ${FARCH} is invalid ***"
                 exit 1
             fi
-            if (is_simulator_arch $FARCH);then
+            # Apple Silicon uses arm64 on BOTH device and simulator. Respect
+            # the requested pass instead of silently rebuilding the device.
+            if (is_simulator_arch $FARCH) || [ "$PLATFORM" = "iphonesimulator" ]; then
                 if [ "$TVOS" = "yes" ]; then
                     PLATFORM="appletvsimulator"
                 fi
@@ -352,11 +354,18 @@ build_simulator_static_lib() {
     VLCSTATICMODULELIST=""
 
     # brute-force test the available architectures we could lipo
-    check_lipo "${OSSTYLE}simulator" x86_64
-    check_lipo "${OSSTYLE}simulator" arm64
-    # watch and XR is not -simulator suffixed in the script unfortunately.
-    check_lipo "${OSSTYLE}" arm64
-    check_lipo "${OSSTYLE}" x86_64
+    if [ "$OSSTYLE" = "xros" ]; then
+        # visionOS simulator SDK/build directory is xrsimulator, never xros.
+        # Do not accidentally package the device archive as a simulator slice.
+        check_lipo "xrsimulator" arm64
+    else
+        check_lipo "${OSSTYLE}simulator" x86_64
+        check_lipo "${OSSTYLE}simulator" arm64
+        if [ "$OSSTYLE" = "watch" ]; then
+            check_lipo "${OSSTYLE}" arm64
+            check_lipo "${OSSTYLE}" x86_64
+        fi
+    fi
 
     if [ ! -z "${VLCSTATICLIBS}" ]; then
         spushd ${VLCROOT}
